# Required: Postgres connection string (a Zerops PostgreSQL service's
# generated connection string, or a local instance for development).
DATABASE_URL=postgres://user:password@localhost:5432/t3code_relay

# Required: the public HTTPS origin this relay is reachable at. Feeds the
# `iss`/`aud` claims on every relay-signed JWT. Defaults to a local origin so
# `pnpm dev` works unconfigured.
RELAY_ISSUER=https://relay.example.com

# Optional: HTTP bind address/port. Defaults to 0.0.0.0:8080.
# HOST=0.0.0.0
# PORT=8080

# Required: environment-link and DPoP-token signing keys (P-256, PEM/base64
# per relayJwt.ts). Generate once per deployment and keep the private key secret.
CLOUD_MINT_PRIVATE_KEY=...
CLOUD_MINT_PUBLIC_KEY=...

# Required: HMAC secret signing the durable APNs delivery job payloads.
APNS_DELIVERY_JOB_SIGNING_SECRET=...

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Required: Apple Push Notification service
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...
